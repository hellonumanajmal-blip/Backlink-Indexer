ADMIN_PASSWORD=
ADMIN_USERNAME=
API_PUBLIC_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=
CORS_ORIGINS=
DATABASE_URL=
INDEXNOW_ENDPOINT=
# Host used in IndexNow ping payloads (the domain the submitted URLs belong to).
# The verification file /{INDEXNOW_KEY}.txt must be reachable on this host.
INDEXNOW_HOST=pintdown.site
# IndexNow key (not a secret — it is published at /{key}.txt): used both in the
# IndexNow ping API payload and as the /{key}.txt verification file the app serves.
# IndexNow notifies Bing, Yandex and DuckDuckGo; Google does not use IndexNow.
#
# MUST MATCH THE BACKEND. Two separate processes read this value:
#   - the Next.js app serves it at https://<host>/<key>.txt
#   - the FastAPI dispatcher sends it in the IndexNow payload
# INDEXNOW_KEY is the canonical name and the FastAPI settings read it directly,
# so exporting it once covers both. If you instead set FI_INDEXNOW_KEY, that
# takes priority on the backend and the two will silently disagree — IndexNow
# then rejects every submission because the key file will not match.
INDEXNOW_KEY=a87465d47cf4a8012f60699324c8cc40

# Where the Next.js route handler reaches the FastAPI backend, server-side only.
# Do NOT use API_PROXY_TARGET for this: it activates a next.config.ts rewrite
# that bypasses src/app/api/[...path]/route.ts, which is the layer translating
# /api/backlinks into /api/indexing/backlinks.
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
# Browser-side API base. Leave empty so the dashboard calls relative /api/*
# paths and goes through the route handler above.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
REDIS_URL=
SESSION_SECRET=
SITE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VALIDATOR_MAX_REDIRECTS=
VALIDATOR_TIMEOUT_SECONDS=
WEBSUB_CIRCUIT_COOLDOWN_SECONDS=
WEBSUB_CIRCUIT_FAILURE_THRESHOLD=
WEBSUB_HUB_URL=
WEBSUB_HUB_URLS=
WEBSUB_MAX_RETRIES=

# Free indexing engine (optional verification). CSE quota: 100 queries/day.
FI_GOOGLE_CSE_API_KEY=
FI_GOOGLE_CSE_CX=
FI_GSC_ACCESS_TOKEN=
FI_GSC_SITE_URL=
FI_PUBLIC_HUB_URL=
FI_OWNED_SITEMAP_URL=