FROM node:20-alpine AS deps

RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

COPY package.json package-lock.json* ./

RUN npm ci --only=production

FROM node:20-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_SITE_URL=https://pintdown.site
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build

FROM node:20-alpine AS runtime

RUN apk add --no-cache \
        libc6-compat \
        openssl \
        curl \
        ca-certificates \
    && rm -rf /var/cache/apk/* \
    && addgroup --system --gid 10001 nodegroup \
    && adduser --system --uid 10001 --ingroup nodegroup --no-create-home nodeuser

WORKDIR /app

COPY --from=builder --chown=nodeuser:nodegroup /app/public ./public
COPY --from=builder --chown=nodeuser:nodegroup /app/.next/standalone ./
COPY --from=builder --chown=nodeuser:nodegroup /app/.next/static ./.next/static

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

USER nodeuser:nodegroup

EXPOSE 3000

HEALTHCHECK \
    --interval=10s \
    --timeout=3s \
    --start-period=30s \
    --retries=3 \
    CMD curl -f http://127.0.0.1:3000/ || exit 1

CMD ["node", "server.js"]
