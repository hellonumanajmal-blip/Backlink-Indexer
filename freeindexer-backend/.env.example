# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="FreeIndexer Backend Engine"
VERSION="0.1.0"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freeindexer
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/freeindexer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Security Settings
JWT_SECRET_KEY=change-this-super-secret-key-min-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","https://pintdown.site"]
ALLOWED_HOSTS=["*"]

# ---------------------------------------------------------------------------
# Public, unauthenticated read API (GET /api/public/featured-backlinks)
#
# Powers a crawlable "featured on" page on a site you own. It returns only
# url/title/platform/domain and hides not_indexed rows. No auth, so it is
# rate-limited per client IP by a fixed-window counter.
# ---------------------------------------------------------------------------
FI_PUBLIC_API_RATE_LIMIT=60
FI_PUBLIC_API_RATE_WINDOW_SECONDS=60
# Scope the public list to one tenant. Empty = every tenant's rows (fine for a
# single-tenant deployment); set it on a multi-tenant deployment.
FI_PUBLIC_FEATURED_TENANT_ID=

# Observability
LOG_LEVEL=INFO
PROMETHEUS_METRICS_ENABLED=true
OPENTELEMETRY_ENABLED=false

# ---------------------------------------------------------------------------
# Backlink indexing dispatch (FREE-ONLY by default)
#
# Note the FI_ prefix: app.core.config.Settings reads FI_-prefixed variables
# only. Every value below is optional — with no keys set, dispatch records a
# "skipped" ping_log for each provider rather than failing.
#
# Reality check (verified 2026): no method, free or paid, can force Google to
# index a URL — Google decides. For third-party backlinks (sites you don't own)
# the free options are narrow:
#   * IndexNow      -> Bing/Yandex/Seznam/Naver only; NOT Google; owned hosts only
#   * WebSub        -> the only free way to nudge Google for URLs you don't own,
#                      by listing them in a feed you host (discovery hint only)
#   * Google Indexing API -> free and reaches Google DIRECTLY, but owner-only
#                      (service account must be a Search Console Owner), so it is
#                      useless for third-party backlinks. Officially
#                      JobPosting/BroadcastEvent only; opt-in via
#                      FI_INDEXER_PROVIDER_ORDER (not attempted by default).
#   * GSC URL Inspection / Bing URL Submission -> also require verifying the
#                      domain, so likewise useless for third-party backlinks
#   * Sitemap ping (google.com/ping?sitemap=) -> DEAD since 2023 (returns 404)
# ---------------------------------------------------------------------------

# Optional opt-in providers, tried in order until one accepts the URL. Empty =
# the pipeline is free-only (IndexNow + WebSub). Turn a provider on with its
# *_ENABLED flag + credentials, then add it here. The Google Indexing API is
# free but opt-in (see the ToS caveat below), e.g.
# FI_INDEXER_PROVIDER_ORDER=google_indexing
# or, with a paid fallback: FI_INDEXER_PROVIDER_ORDER=google_indexing,indexbolt
FI_INDEXER_PROVIDER_ORDER=
FI_INDEXER_HTTP_TIMEOUT_SECONDS=15
FI_INDEXER_BATCH_SIZE=50

# IndexNow: free and near-instant for Bing/Yandex/Seznam/Naver. Google does not
# participate. Usable ONLY for domains you control, because the protocol
# requires serving <key>.txt at the root of the submitted host.
FI_INDEXNOW_ENABLED=true
FI_INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# The key is shared with the Next.js frontend, which serves it at
# https://<your-domain>/<key>.txt. Both sides must hold the same value or
# IndexNow rejects every submission when it fetches the key file.
#
# Canonical name is the unprefixed INDEXNOW_KEY (see the repo-root .env.example)
# and these settings read it directly, so setting it once covers both processes.
# FI_INDEXNOW_KEY below is an optional override for prefix-consistent setups —
# if you set it, it wins on the backend, so remember to keep the frontend's
# INDEXNOW_KEY identical or the key file will not match what you submit.
FI_INDEXNOW_KEY=
# Comma-separated apex domains you own; subdomains match automatically.
FI_OWNED_DOMAINS=

# WebSub (PubSubHubbub): free, and the ONLY free channel that can reach Google
# for URLs you don't own. It broadcasts a feed you host (which must list the
# backlink URLs) so Google's Feedfetcher and Bing re-crawl it. Discovery hint
# only — Google still decides what to index. Skipped until a feed URL is set.
FI_WEBSUB_ENABLED=true
# A public feed on a domain you control that lists the backlink URLs. The
# frontend already serves one, e.g. https://pintdown.site/feed.xml
FI_WEBSUB_FEED_URL=
# Comma-separated hubs. Google runs the first; websubhub.com is a public relay.
FI_WEBSUB_HUB_URLS=https://pubsubhubbub.appspot.com,https://websubhub.com

# Google Indexing API: free and the only channel that notifies Google DIRECTLY,
# but owner-only — the service account must be an Owner of the domain in Google
# Search Console. It therefore CANNOT index third-party backlinks (comes back
# "not_applicable", like IndexNow) and only helps for domains in FI_OWNED_DOMAINS.
# A 200 means Google accepted the notification, NOT that it indexed the page.
#
# OPT-IN BY DESIGN. Google officially restricts this API to JobPosting and
# BroadcastEvent pages. Using it for regular pages is a common unofficial
# workaround; if Google decides that is misuse they can revoke *this API*
# for the Cloud project (not a domain/Search penalty — you just lose the
# feature). It is therefore NOT in the always-attempted free chain: even with
# a valid service account it will not fire until you add `google_indexing` to
# FI_INDEXER_PROVIDER_ORDER above. Read this caveat first, then opt in.
#
# Setup: create a Google Cloud service account, enable the "Web Search Indexing
# API", download its JSON key, and add its client_email as an Owner in Search
# Console for each domain in FI_OWNED_DOMAINS.
FI_GOOGLE_INDEXING_ENABLED=true
FI_GOOGLE_INDEXING_CLIENT_EMAIL=
# Paste the service account JSON's private_key. Keep the literal \n escapes (the
# backend converts them) or wrap the whole value in quotes with real newlines.
FI_GOOGLE_INDEXING_PRIVATE_KEY=

# --- Optional PAID indexers (disabled by default; the pipeline is free-only) ---

# IndexBolt — https://www.indexbolt.com/url-indexing-api
FI_INDEXBOLT_ENABLED=false
FI_INDEXBOLT_API_KEY=
FI_INDEXBOLT_BASE_URL=https://www.indexbolt.com/api/v1
# "normal" = 1 credit/URL, "instant" = 10 credits/URL
FI_INDEXBOLT_INDEXING_TYPE=normal
FI_INDEXBOLT_PROJECT_ID=

# Rapid URL Indexer — https://rapidurlindexer.com/indexing-api/
FI_RAPIDURLINDEXER_ENABLED=false
FI_RAPIDURLINDEXER_API_KEY=
FI_RAPIDURLINDEXER_BASE_URL=https://rapidurlindexer.com/wp-json/api/v1
# Apex Mode costs 3 credits/URL for a ~5 minute crawl instead of hours.
FI_RAPIDURLINDEXER_APEX_MODE=false

# ---------------------------------------------------------------------------
# FREE INDEXING ENGINE
# Validation, crawlability, backlink inspection, discovery, verification, retry.
# Never claims INDEXED from HTTP 200 / our crawler / a discovery POST.
# ---------------------------------------------------------------------------
FI_ENGINE_HTTP_TIMEOUT_SECONDS=15
FI_ENGINE_MAX_REDIRECTS=8
FI_PUBLIC_HUB_URL=
FI_OWNED_SITEMAP_URL=
FI_GSC_ACCESS_TOKEN=
FI_GSC_SITE_URL=
# Optional Programmable Search JSON API. Daily free quota is 100 queries.
# A miss is UNKNOWN (CSE is not the full Google index).
FI_GOOGLE_CSE_API_KEY=
FI_GOOGLE_CSE_CX=
FI_GOOGLE_CSE_DAILY_QUOTA=100
# When true, every eligible third-party URL uses hub + RSS/Atom/JSON + WebSub.
# Owner-only channels (IndexNow, sitemap, Google Indexing API) stay owner-only.
# WEBSUB_ACCEPTED is never INDEXED.
FI_MAX_DISCOVERY_MODE=false
